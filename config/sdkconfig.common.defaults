# Shared ESP32-S3 + LVGL + Withthewind RGB defaults for lvglframe monorepo.
# Layered via SDKCONFIG_DEFAULTS in root / esp32_s3_frame CMakeLists.txt (project-specific files override).

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# Keep PSRAM for heap (frame buffers / LVGL / PNG decode), not .text/.rodata XIP.
# CONFIG_SPIRAM_FETCH_INSTRUCTIONS is not set
# CONFIG_SPIRAM_RODATA is not set
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# CONFIG_ESP32S3_INSTRUCTION_CACHE_16KB is not set
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_FREERTOS_HZ=1000
# Timer service on CPU0锛泃askLVGL 閽夊湪 CPU1锛屽噺灏戝悓鏍告姠鍗犮€?
CONFIG_FREERTOS_TIMER_TASK_AFFINITY_CPU0=y
# CONFIG_FREERTOS_TIMER_TASK_NO_AFFINITY is not set
CONFIG_FREERTOS_TIMER_TASK_PRIORITY=2
# First-frame lv_refr_now + SPIFFS PNG decode can block taskLVGL >5s.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15

# LVGL Kconfig is registered by the lvgl component; keep LVGL options in each
# project's sdkconfig.defaults / presets (not here) to avoid "unknown kconfig symbol" warnings.

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# Withthewind RGB/LVGL 鈥?3 FB + avoid_tear + bounce (must match withthewind_board_lvgl_init)
CONFIG_BSP_LCD_RGB_BUFFER_NUMS=3
CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_HEIGHT=40
CONFIG_BSP_DISPLAY_LVGL_AVOID_TEAR=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=32768

CONFIG_BOARD_BACKLIGHT_PWM_GPIO_NUM=4
CONFIG_BOARD_BACKLIGHT_LEDC_FREQ_HZ=5000
CONFIG_BOARD_BACKLIGHT_MIN_PERCENT=10
CONFIG_BOARD_BEEP_VIA_IO_EXPANDER=y
CONFIG_BOARD_BEEP_EXPANDER_PIN=9
